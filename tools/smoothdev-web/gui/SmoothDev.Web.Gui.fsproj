<Project Sdk="Microsoft.NET.Sdk">
  <!-- The smoothdev-web console: Lit web components written in F# (Firelight), compiled by vite-plugin-fable. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/Model.fs" />
    <Compile Include="src/Api.fs" />
    <Compile Include="src/Theme.fs" />
    <Compile Include="src/Components.fs" />
    <Compile Include="src/Console.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- the shared controls and theme tokens, from this repository's ui/ -->
    <ProjectReference Include="..\..\..\ui\smoothdev.ui.fable.webcomponents\smoothdev.ui.fable.webcomponents.fsproj" />
  </ItemGroup>
  <Import Project="..\..\..\.paket\Paket.Restore.targets" />
</Project>
